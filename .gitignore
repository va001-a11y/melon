# Dependencies — never commit these. They are ~173 MB and contain
# OS-specific binaries (esbuild.exe, rollup-win32-x64) that break on
# any other platform.
node_modules/

# Build output — regenerated by `npm run build`
dist/
*.tsbuildinfo

# Local runtime state
.melon-ports.json

# Distribution zips produced by `npm run package`
Melon-*.zip

# Secrets. Melon is bring-your-own-key and stores keys in the browser,
# so there should be nothing here — this is a backstop, not a routine.
.env
.env.*
*.key
*.pem

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
