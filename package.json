{
  "name": "melon",
  "private": true,
  "version": "0.7.1",
  "license": "MIT",
  "description": "Melon — universal multi-model AI",
  "workspaces": [
    "core",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w core && npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "melon": "node scripts/launch.mjs",
    "package": "node scripts/package.mjs",
    "web": "npm run dev:web -w client",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2"
  }
}
